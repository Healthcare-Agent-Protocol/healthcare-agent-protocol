{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Healthcare Agent Protocol",
  "colors": {
    "primary": "#0F766E",
    "light": "#14B8A6",
    "dark": "#0D9488"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "pages": [
      "docs/capabilities",
      "spec/identity/hap-1"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Discussions",
        "href": "https://github.com/Healthcare-Agent-Protocol/healthcare-agent-protocol/discussions"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/Healthcare-Agent-Protocol/healthcare-agent-protocol"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Healthcare-Agent-Protocol/healthcare-agent-protocol"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/docs/capabilities"
    },
    {
      "source": "/index",
      "destination": "/docs/capabilities"
    },
    {
      "source": "/docs/architecture",
      "destination": "/docs/capabilities"
    },
    {
      "source": "/spec/identity/hap-1-http",
      "destination": "/spec/identity/hap-1#api-requests"
    },
    {
      "source": "/spec/identity/hap-1-voice",
      "destination": "/spec/identity/hap-1#phone-calls"
    },
    {
      "source": "/spec/claims/claim-status",
      "destination": "https://github.com/Healthcare-Agent-Protocol/healthcare-agent-protocol/blob/main/spec/claims/claim-status.md"
    },
    {
      "source": "/community/contributing",
      "destination": "https://github.com/Healthcare-Agent-Protocol/healthcare-agent-protocol/blob/main/CONTRIBUTING.md"
    },
    {
      "source": "/community/security",
      "destination": "https://github.com/Healthcare-Agent-Protocol/healthcare-agent-protocol/blob/main/SECURITY.md"
    }
  ]
}
